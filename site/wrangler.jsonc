{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mini-claude-learning-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mini-claude.evanqhu.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
